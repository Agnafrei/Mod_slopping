    // Keep the stamina bar at full length and draw the burned part as a darker section.
    [HarmonyPatch(typeof(Hud), "UpdateStamina")]
    internal static class Hud_UpdateStamina_Patch
    {
        // Hud.SetStaminaBarSize is private, so call it through a cached delegate.
        private static readonly Action<Hud, float> SetBarSize =
            (Action<Hud, float>)Delegate.CreateDelegate(
                typeof(Action<Hud, float>),
                AccessTools.Method(typeof(Hud), "SetStaminaBarSize"));

        private static readonly BarGradient Gradient = new BarGradient();

        private static RectTransform _burnedBar;
        private static UnityEngine.UI.Image _burnedImage;
        private static float _alpha = 1f;
        private static float _fullTimer;

        private static void Postfix(Hud __instance, Player player)
        {
            float stamina = player.GetStamina();
            float maxStamina = player.GetMaxStamina();
            float burned = StaminaBurn.Applied;
            float total = maxStamina + burned;

            if (total <= 0f)
                return;

            // Same size formula the game uses, but for max + burned so the bar never shrinks.
            SetBarSize(__instance, total / 25f * 32f);

            // Fill is now a fraction of the full-length bar.
            __instance.m_staminaBar2Slow.SetValue(stamina / total);
            __instance.m_staminaBar2Fast.SetValue(stamina / total);

            // While burned stamina is coming back, keep the whole stamina display on screen.
            bool recovering = Time.time < StaminaBurn.RegenVisibleUntil;
            if (recovering && __instance.m_staminaAnimator != null)
                __instance.m_staminaAnimator.SetBool("Visible", true);

            UpdateBurnedBar(__instance, burned, stamina, maxStamina, recovering);
        }

        private static void UpdateBurnedBar(Hud hud, float burned, float stamina, float maxStamina, bool recovering)
        {
            // (Re)create the overlay if it doesn't exist yet or the HUD was rebuilt.
            if (_burnedBar == null)
            {
                GameObject go = new GameObject("BurnedStaminaBar",
                    typeof(RectTransform), typeof(CanvasRenderer), typeof(UnityEngine.UI.Image));
                go.transform.SetParent(hud.m_staminaBar2Root.transform, false);

                _burnedBar = go.GetComponent<RectTransform>();
                _burnedImage = go.GetComponent<UnityEngine.UI.Image>();
                _burnedImage.raycastTarget = false;
                _burnedImage.type = UnityEngine.UI.Image.Type.Simple;

                // Anchor to the right edge, full height.
                _burnedBar.anchorMin = new Vector2(1f, 0f);
                _burnedBar.anchorMax = new Vector2(1f, 1f);
                _burnedBar.pivot = new Vector2(1f, 0.5f);

                HudUtil.PlaceBehind(_burnedBar, hud.m_staminaBar2Root.transform, hud.m_staminaBar2Slow.transform);
            }

            // Own full-stamina timer, mirroring the game's hide timer but with a shorter delay,
            // so the burned section fades out before the regular bar does.
            // It stays at zero while burn is recovering.
            if (recovering || stamina < maxStamina - 0.01f)
                _fullTimer = 0f;
            else
                _fullTimer += Time.deltaTime;

            bool gameVisible = hud.m_staminaAnimator == null || hud.m_staminaAnimator.GetBool("Visible");
            bool wanted = gameVisible && _fullTimer < OutwardSurvivalPlugin.HideDelay.Value;

            _alpha = Mathf.MoveTowards(_alpha, wanted ? 1f : 0f,
                OutwardSurvivalPlugin.FadeSpeed.Value * Time.deltaTime);

            bool visible = burned > 0.01f && _alpha > 0.001f;
            _burnedBar.gameObject.SetActive(visible);
            if (!visible)
                return;

            // Position and size are applied every update so the config sliders take effect live.
            // Width uses the same units as SetStaminaBarSize.
            float width = Mathf.Max(0f, burned / 25f * 32f + OutwardSurvivalPlugin.BarWidthAdjust.Value);
            _burnedBar.sizeDelta = new Vector2(width, OutwardSurvivalPlugin.BarHeightAdjust.Value);
            _burnedBar.anchoredPosition = new Vector2(
                OutwardSurvivalPlugin.BarOffsetX.Value,
                OutwardSurvivalPlugin.BarOffsetY.Value);

            _burnedImage.sprite = Gradient.Get(OutwardSurvivalPlugin.GradientStrength.Value);

            // Darker version of the bar's own color; the gradient texture darkens the bottom.
            UnityEngine.UI.Image source =
                hud.m_staminaBar2Fast.GetComponentInChildren<UnityEngine.UI.Image>();
            Color c = source != null ? source.color : _burnedImage.color;
            float b = OutwardSurvivalPlugin.BurnedBarBrightness.Value;

            // Smoothstep easing so the fade starts and ends gently.
            float eased = _alpha * _alpha * (3f - 2f * _alpha);

            _burnedImage.color = new Color(
                c.r * b, c.g * b, c.b * b,
                eased * OutwardSurvivalPlugin.BarOpacity.Value);
        }
    }

    // Replaces the game's UpdateHealth so the health bars only ever receive one set of values per frame.
    // (Running the original and then correcting it made the "recent damage" trail flash.)
    // The original method only did four things: size the bar, set both bars, and write the health number.
    [HarmonyPatch(typeof(Hud), "UpdateHealth")]
    internal static class Hud_UpdateHealth_Patch
    {
        // Hud.SetHealthBarSize is private, so call it through a cached delegate.
        private static readonly Action<Hud, float> SetBarSize =
            (Action<Hud, float>)Delegate.CreateDelegate(
                typeof(Action<Hud, float>),
                AccessTools.Method(typeof(Hud), "SetHealthBarSize"));

        private static readonly BarGradient Gradient = new BarGradient();

        // The health number's text object is a TextMeshPro type. Reaching it by reflection means
        // this project doesn't need a reference to the TextMeshPro assembly.
        private static readonly FieldInfo HealthTextField = AccessTools.Field(typeof(Hud), "m_healthText");

        private static RectTransform _burnedBar;
        private static UnityEngine.UI.Image _burnedImage;
        private static Component _textComponent;
        private static PropertyInfo _textProperty;
        private static int _lastShown = int.MinValue;

        // Returning false skips the game's own UpdateHealth.
        private static bool Prefix(Hud __instance, Player player)
        {
            float maxHealth = player.GetMaxHealth();
            float burned = HealthBurn.Applied;
            float total = maxHealth + burned;
            float health = player.GetHealth();

            // Same size formula the game uses, but for max + burned so the bar never shrinks.
            SetBarSize(__instance, total / 25f * 32f);

            // The bars take absolute values, so give them the full-length maximum.
            __instance.m_healthBarFast.SetMaxValue(total);
            __instance.m_healthBarFast.SetValue(health);
            __instance.m_healthBarSlow.SetMaxValue(total);
            __instance.m_healthBarSlow.SetValue(health);

            SetHealthText(__instance, Mathf.CeilToInt(health));

            UpdateBurnedBar(__instance, burned);
            return false;
        }

        // Writes the health number, only when it changed or the HUD created a new text object.
        private static void SetHealthText(Hud hud, int shown)
        {
            if (HealthTextField == null)
                return;

            Component text = HealthTextField.GetValue(hud) as Component;
            if (text == null)
                return;

            if (shown == _lastShown && text == _textComponent)
                return;

            if (text != _textComponent || _textProperty == null)
            {
                _textComponent = text;
                _textProperty = text.GetType().GetProperty("text", typeof(string));
            }

            if (_textProperty == null)
                return;

            _textProperty.SetValue(text, shown.ToString(CultureInfo.InvariantCulture), null);
            _lastShown = shown;
        }

        private static void UpdateBurnedBar(Hud hud, float burned)
        {
            // (Re)create the overlay if it doesn't exist yet or the HUD was rebuilt.
            if (_burnedBar == null)
            {
                GameObject go = new GameObject("BurnedHealthBar",
                    typeof(RectTransform), typeof(CanvasRenderer), typeof(UnityEngine.UI.Image));
                go.transform.SetParent(hud.m_healthBarRoot, false);

                _burnedBar = go.GetComponent<RectTransform>();
                _burnedImage = go.GetComponent<UnityEngine.UI.Image>();
                _burnedImage.raycastTarget = false;
                _burnedImage.type = UnityEngine.UI.Image.Type.Simple;

                // Anchor to the right edge, full height.
                _burnedBar.anchorMin = new Vector2(1f, 0f);
                _burnedBar.anchorMax = new Vector2(1f, 1f);
                _burnedBar.pivot = new Vector2(1f, 0.5f);

                // Above the "recent damage" trail bar, below the real health fill, so the trail
                // can't show through the burned section.
                HudUtil.PlaceBetween(_burnedBar, hud.m_healthBarRoot,
                    hud.m_healthBarSlow.transform, hud.m_healthBarFast.transform);

                if (OutwardSurvivalPlugin.DebugLogHealth.Value)
                {
                    StringBuilder sb = new StringBuilder();
                    for (int i = 0; i < hud.m_healthBarRoot.childCount; i++)
                        sb.Append(i).Append(':').Append(hud.m_healthBarRoot.GetChild(i).name).Append("  ");

                    OutwardSurvivalPlugin.Log.LogInfo(
                        $"[Health] bar root children: {sb}| burned section index {_burnedBar.GetSiblingIndex()}");
                }
            }

            bool visible = burned > 0.01f;
            _burnedBar.gameObject.SetActive(visible);
            if (!visible)
                return;

            // Position and size are applied every update so the config sliders take effect live.
            // Width uses the same units as SetHealthBarSize.
            float width = Mathf.Max(0f, burned / 25f * 32f + OutwardSurvivalPlugin.HealthBarWidthAdjust.Value);
            _burnedBar.sizeDelta = new Vector2(width, OutwardSurvivalPlugin.HealthBarHeightAdjust.Value);
            _burnedBar.anchoredPosition = new Vector2(
                OutwardSurvivalPlugin.HealthBarOffsetX.Value,
                OutwardSurvivalPlugin.HealthBarOffsetY.Value);

            _burnedImage.sprite = Gradient.Get(OutwardSurvivalPlugin.HealthBarGradientStrength.Value);

            Color c = OutwardSurvivalPlugin.HealthBarColor.Value;
            _burnedImage.color = new Color(c.r, c.g, c.b, c.a * OutwardSurvivalPlugin.HealthBarOpacity.Value);
        }
    }
}
