        private const string SaveKey = "OutwardSurvival.BurnedStamina";

        // Live counter, updated on every stamina spend.
        public static float Burned;

        // Burn actually subtracted from max stamina at the last food update.
        // The HUD uses this so the bar matches the real max stamina.
        public static float Applied;

        // While Time.time is below this, the stamina HUD is held visible.
        public static float RegenVisibleUntil;

        private static bool _wasRested;
        private static bool _restedInitialized;
        private static float _lastRemaining;
        private static float _lastRegenTime = -1f;
        private static float _lastCombatTime = -999f;

        // Name of the character that just died, so the respawn keeps the live burn values.
        private static string _deathCharacter;

        // Cached status effect checks used when stamina is spent.
        private static float _effectsCheckedAt = -999f;
        private static bool _corpseRun;
        private static bool _poisoned;

        // Looked up by name so a typo or rename in the game's code can't break compilation.
        private static readonly Func<StatusEffect, float> GetRemaining = BuildRemainingGetter();
        private static readonly Func<Player, bool> IsTargeted =
            BuildPlayerBool("IsTargeted", "enemy-targeting detection for combat is off");
        private static readonly Func<Player, bool> IsEncumberedCheck =
            BuildPlayerBool("IsEncumbered", "the direct encumbered check is off (the status effect is still checked)");

        private static Func<StatusEffect, float> BuildRemainingGetter()
        {
            foreach (string name in new[] { "GetRemaningTime", "GetRemainingTime" })
            {
                MethodInfo method = AccessTools.Method(typeof(StatusEffect), name);
                if (method != null && method.ReturnType == typeof(float))
                {
                    try
                    {
                        return (Func<StatusEffect, float>)Delegate.CreateDelegate(
                            typeof(Func<StatusEffect, float>), method);
                    }
                    catch (ArgumentException)
                    {
                    }
                }
            }

            OutwardSurvivalPlugin.Log?.LogWarning(
                "Could not find the status effect remaining-time method; " +
                "Rested refresh detection is off (only gaining Rested will be detected).");
            return null;
        }

        private static Func<Player, bool> BuildPlayerBool(string name, string consequence)
        {
            MethodInfo method = AccessTools.Method(typeof(Player), name);
            if (method != null && method.ReturnType == typeof(bool) && method.GetParameters().Length == 0)
            {
                try
                {
                    return (Func<Player, bool>)Delegate.CreateDelegate(typeof(Func<Player, bool>), method);
                }
                catch (ArgumentException)
                {
                }
            }

            OutwardSurvivalPlugin.Log?.LogWarning($"Player.{name}() not found; {consequence}.");
            return null;
        }

        public static void OnStaminaSpent(Player player, float amount)
        {
            if (amount <= 0f)
                return;

            RefreshEffects(player);

            // Corpse Run: stamina use doesn't burn anything.
            if (OutwardSurvivalPlugin.NoBurnDuringCorpseRun.Value && _corpseRun)
                return;

            float rate = OutwardSurvivalPlugin.BurnPercent.Value / 100f;

            // Poisoned: the burn rate is multiplied.
            if (OutwardSurvivalPlugin.PoisonBoostsBurn.Value && _poisoned)
                rate *= OutwardSurvivalPlugin.PoisonBurnMultiplier.Value;

            Burned += amount * rate;
        }

        // Re-check the status effects used by the burn rules, at most twice a second.
        private static void RefreshEffects(Player player)
        {
            float now = Time.time;
            if (now - _effectsCheckedAt < 0.5f)
                return;
            _effectsCheckedAt = now;

            bool corpseRun = false;
            bool poisoned = false;
            foreach (StatusEffect se in player.GetSEMan().GetStatusEffects())
            {
                if (IsEffect(se, "CorpseRun", "$se_corpserun_name"))
                    corpseRun = true;
                else if (IsEffect(se, "Poison", "$se_poison_name"))
                    poisoned = true;
            }

            _corpseRun = corpseRun;
            _poisoned = poisoned;
        }

