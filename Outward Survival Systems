        // Called when the local player dies.
        public static void OnLocalDeath()
        {
            if (OutwardSurvivalPlugin.ResetOnDeath.Value)
                Clear("died");

            if (OutwardSurvivalPlugin.ResetHealthOnDeath.Value)
                HealthBurn.Clear("died");

            // Remember who died, so the respawn keeps the live values instead of older saved ones.
            _deathCharacter = CurrentCharacterName();
        }

        // Persistence in the character's own save data.
        public static void LoadFrom(Player player)
        {
            // Treat whatever Rested state exists right after loading as the starting point,
            // not as a newly gained buff.
            _restedInitialized = false;
            _lastRegenTime = -1f;
            HealthBurn.ResetTimers();

            // Respawning after a death: keep the values we already have.
            string name = CurrentCharacterName();
            if (_deathCharacter != null && _deathCharacter == name)
            {
                _deathCharacter = null;
                OutwardSurvivalPlugin.Log.LogInfo(
                    $"Respawned; burn carried over: stamina {Burned:F1}, health {HealthBurn.Burned:F1}");
                return;
            }
            _deathCharacter = null;

            float value = 0f;
            string text;
            if (player.m_customData.TryGetValue(SaveKey, out text))
                float.TryParse(text, NumberStyles.Float, CultureInfo.InvariantCulture, out value);

            Burned = Mathf.Max(0f, value);
            Applied = 0f;

            float healthValue = 0f;
            if (player.m_customData.TryGetValue(HealthBurn.SaveKey, out text))
                float.TryParse(text, NumberStyles.Float, CultureInfo.InvariantCulture, out healthValue);

            HealthBurn.Burned = Mathf.Max(0f, healthValue);
            HealthBurn.Applied = 0f;

            OutwardSurvivalPlugin.Log.LogInfo(
                $"Loaded burn from character data: stamina {Burned:F1}, health {HealthBurn.Burned:F1}");
        }

        public static void SaveTo(Player player)
        {
            player.m_customData[SaveKey] = Burned.ToString("R", CultureInfo.InvariantCulture);
            player.m_customData[HealthBurn.SaveKey] = HealthBurn.Burned.ToString("R", CultureInfo.InvariantCulture);
        }

        // Detect the Rested buff being gained or refreshed.
        public static void CheckRested(Player player)
        {
            SE_Rested rested = FindRested(player);
            bool has = rested != null;

            float remaining = 0f;
            if (has && GetRemaining != null)
                remaining = GetRemaining(rested);

            if (!_restedInitialized)
            {
                _restedInitialized = true;
                _wasRested = has;
                _lastRemaining = remaining;
                return;
            }

            bool gained = has && !_wasRested;
            bool refreshed = has && _wasRested && GetRemaining != null && remaining > _lastRemaining + 1f;

            if ((gained || refreshed) && OutwardSurvivalPlugin.ResetOnRested.Value)
                Clear(gained ? "gained Rested" : "Rested refreshed");

            _wasRested = has;
            _lastRemaining = remaining;
        }

        private static SE_Rested FindRested(Player player)
        {
            foreach (StatusEffect se in player.GetSEMan().GetStatusEffects())
            {
                SE_Rested rested = se as SE_Rested;
                if (rested != null)
                    return rested;
            }
            return null;
        }

        // Slowly restore burned stamina while the player is sitting.
        public static void Regenerate(Player player)
        {
            float now = Time.time;
            bool firstCall = _lastRegenTime < 0f;
            float dt = now - _lastRegenTime;
            _lastRegenTime = now;

            // Ignore the first call and long gaps (loading, pauses).
            if (firstCall || dt <= 0f || dt > 3f || Burned <= 0f)
                return;

            if (!player.IsSitting())
                return;

            string blocked = BlockedBy(player);
            if (blocked != null)
            {
                if (OutwardSurvivalPlugin.DebugLogStamina.Value)
                    OutwardSurvivalPlugin.Log.LogInfo($"[Stamina] recovery blocked: {blocked}.");
                return;
            }

            float rate = OutwardSurvivalPlugin.RestorePerSecond.Value;

            // Near a fire: the game's own heat area, the same check that gives the Warm status.
            if (EffectArea.IsPointInsideArea(player.transform.position, EffectArea.Type.Heat, 0.5f))
                rate += OutwardSurvivalPlugin.FireBonusPerSecond.Value;

            if (OutwardSurvivalPlugin.ScaleWithComfort.Value)
                rate *= Mathf.Max(1, player.GetComfortLevel());

            float before = Burned;
            Burned = Mathf.Max(0f, Burned - rate * dt);

            // Keep the stamina HUD on screen while burn is coming back.
            if (Burned < before)
                RegenVisibleUntil = now + 1.5f;
        }

        // Returns why recovery is blocked right now, or null if it isn't.
        private static string BlockedBy(Player player)
        {
            if (OutwardSurvivalPlugin.BlockInCombat.Value && InCombat(player))
                return "in combat";

            if (OutwardSurvivalPlugin.BlockWhenEncumbered.Value &&
                IsEncumberedCheck != null && IsEncumberedCheck(player))
                return "encumbered";

            foreach (StatusEffect se in player.GetSEMan().GetStatusEffects())
            {
                if (OutwardSurvivalPlugin.BlockWhenWet.Value && IsEffect(se, "Wet", "$se_wet_name"))
                    return "wet";
                if (OutwardSurvivalPlugin.BlockWhenFreezing.Value && IsEffect(se, "Freezing", "$se_freezing_name"))
                    return "freezing";
                if (OutwardSurvivalPlugin.BlockWhenCold.Value && IsEffect(se, "Cold", "$se_cold_name"))
                    return "cold";
                if (OutwardSurvivalPlugin.BlockWhenEncumbered.Value && IsEffect(se, "Encumbered", "$se_encumbered_name"))
                    return "encumbered";
            }

            return null;
        }

        private static bool InCombat(Player player)
        {
            if (Time.time - _lastCombatTime < OutwardSurvivalPlugin.CombatCooldown.Value)
                return true;

            if (IsTargeted != null && IsTargeted(player))
            {
                _lastCombatTime = Time.time;
                return true;
            }

            return false;
        }

        // Exact match on the effect's asset name (ignoring "(Clone)") or its display token.
        private static bool IsEffect(StatusEffect se, string assetName, string token)
        {
            if (se.m_name == token)
                return true;

            string n = se.name;
            if (n == null)
                return false;

            if (n.EndsWith("(Clone)", StringComparison.Ordinal))
                n = n.Substring(0, n.Length - "(Clone)".Length);

            return string.Equals(n.Trim(), assetName, StringComparison.OrdinalIgnoreCase);
        }

        public static void Clear(string reason)
        {
            if (Burned > 0f)
            {
                OutwardSurvivalPlugin.Log.LogInfo($"Burned stamina cleared ({reason}).");

                // Show the stamina HUD briefly so the player sees the burn go away.
                RegenVisibleUntil = Time.time + 2f;
            }

            Burned = 0f;
        }
    }

