    // A small vertical gradient sprite: white at the top, darker toward the bottom.
    // It is multiplied by the Image color. Each bar keeps its own instance.
    internal sealed class BarGradient
    {
        private const int Steps = 32;

        private Texture2D _tex;
        private Sprite _sprite;
        private float _strength = -1f;

        public Sprite Get(float strength)
        {
            if (_tex == null)
            {
                _tex = new Texture2D(1, Steps, TextureFormat.RGBA32, false);
                _tex.wrapMode = TextureWrapMode.Clamp;
                _tex.filterMode = FilterMode.Bilinear;
                _tex.hideFlags = HideFlags.HideAndDontSave;

                _sprite = Sprite.Create(_tex, new Rect(0f, 0f, 1f, Steps), new Vector2(0.5f, 0.5f), 100f);
                _sprite.hideFlags = HideFlags.HideAndDontSave;

                _strength = -1f;
            }

            if (!Mathf.Approximately(strength, _strength))
            {
                for (int y = 0; y < Steps; y++)
                {
                    float t = y / (float)(Steps - 1); // 0 = bottom, 1 = top
                    float shade = Mathf.Lerp(1f - strength, 1f, t);
                    _tex.SetPixel(0, y, new Color(shade, shade, shade, 1f));
                }
                _tex.Apply();
                _strength = strength;
            }

            return _sprite;
        }
    }

    internal static class HudUtil
    {
        // The direct child of root that contains the given bar (or null if it isn't under root).
        private static Transform TopLevelChild(Transform root, Transform bar)
        {
            Transform t = bar;
            while (t != null && t.parent != root)
                t = t.parent;
            return t;
        }

        // Put the overlay just before the bar in the draw order, so the real bars draw on top of it.
        public static void PlaceBehind(Transform overlay, Transform root, Transform bar)
        {
            Transform t = TopLevelChild(root, bar);
            if (t != null)
                overlay.SetSiblingIndex(t.GetSiblingIndex());
            else
                overlay.SetAsFirstSibling();
        }

        // Put the overlay between two bars: above the one drawn first (the "slow" trail bar)
        // and below the one drawn last (the "fast" bar). If both bars share one container,
        // it can't go between them and ends up behind both.
        public static void PlaceBetween(Transform overlay, Transform root, Transform barA, Transform barB)
        {
            Transform a = TopLevelChild(root, barA);
            Transform b = TopLevelChild(root, barB);

            Transform front;
            if (a != null && b != null)
                front = a.GetSiblingIndex() > b.GetSiblingIndex() ? a : b;
            else
                front = a != null ? a : b;

            if (front != null)
                overlay.SetSiblingIndex(front.GetSiblingIndex());
            else
                overlay.SetAsFirstSibling();
        }
    }

    internal static class HealthBurn
    {
        public const string SaveKey = "OutwardSurvival.BurnedHealth";

        // Live burned health, taken off max health.
        public static float Burned;

        // Burn actually subtracted from max health at the last food update (used by the HUD).
        public static float Applied;

        // Frame in which max health was just lowered by us; health clamps in that frame are not damage.
        public static int IgnoreDecreaseFrame = -1;

        private static float _lastHungerTick = -1f;
        private static float _loadedAt = -999f;

        // Found by name so a rename in the game's code can't break compilation.
        private static readonly Func<Player, ICollection> GetFoods = BuildFoodsGetter();

        private static Func<Player, ICollection> BuildFoodsGetter()
        {
            MethodInfo method = AccessTools.Method(typeof(Player), "GetFoods");
            if (method != null && method.GetParameters().Length == 0 &&
                typeof(ICollection).IsAssignableFrom(method.ReturnType))
            {
                try
                {
                    return (Func<Player, ICollection>)Delegate.CreateDelegate(
                        typeof(Func<Player, ICollection>), method);
                }
                catch (ArgumentException)
                {
                }
            }

            FieldInfo field = AccessTools.Field(typeof(Player), "m_foods");
            if (field != null && typeof(ICollection).IsAssignableFrom(field.FieldType))
                return player => (ICollection)field.GetValue(player);

            OutwardSurvivalPlugin.Log?.LogWarning(
                "Could not find the player's food list; hunger detection is off.");
            return null;
        }

        // Hungry = no active food in any of the food slots.
        public static bool IsHungry(Player player)
        {
            if (GetFoods == null)
                return false;

            ICollection foods = GetFoods(player);
            return foods != null && foods.Count == 0;
        }

        public static void ResetTimers()
        {
            _lastHungerTick = -1f;
            _loadedAt = Time.time;
        }

        public static void DebugApply(float amount)
        {
            Burned += amount;
            OutwardSurvivalPlugin.Log.LogInfo($"Debug: added {amount:F1} burned health (now {Burned:F1}).");
        }

        public static void Clear(string reason)
        {
            if (Burned > 0f)
                OutwardSurvivalPlugin.Log.LogInfo($"Burned health cleared ({reason}).");

            Burned = 0f;
        }

        // Restore some burned health (never more than there is).
        private static void Restore(float amount, string reason)
        {
            if (amount <= 0f || Burned <= 0f)
                return;

            float restored = Mathf.Min(amount, Burned);
            Burned -= restored;

            OutwardSurvivalPlugin.Log.LogInfo(
                $"Burned health restored by {restored:F1} ({reason}); {Burned:F1} left.");
        }

        // Called when the local player wakes up from sleeping.
        public static void OnWakeUp()
        {
            float percent = OutwardSurvivalPlugin.SleepHealthRestorePercent.Value;
            if (percent > 0f)
                Restore(Burned * percent / 100f, "slept");
        }

        // Called when a healing effect (potion) starts on the local player.
        public static void OnHealingEffect(SE_Stats effect)
        {
            // Status effects restored while loading a character are not new potions.
            if (Time.time - _loadedAt < 3f)
                return;

            float healing = effect.m_healthUpFront + effect.m_healthOverTime;
            if (healing <= 0f)
                return;

            Restore(healing * OutwardSurvivalPlugin.PotionHealthRestorePercent.Value / 100f,
                $"healing potion, {healing:F0} healing");
        }

        // Called just before the local player's health is set. A drop is damage; burn part of it.
        public static void OnHealthSet(Player player, float newHealth)
        {
            if (Time.frameCount == IgnoreDecreaseFrame)
                return;

            float current = player.GetHealth();
            float max = player.GetMaxHealth();

            // Healing, or no change.
            if (newHealth >= current)
                return;

            // Health being clamped down to a lowered max is not damage.
            if (newHealth >= max - 0.001f)
                return;

            float damage = current - Mathf.Max(0f, newHealth);
            if (damage <= 0f)
                return;

            float rate = OutwardSurvivalPlugin.HealthBurnPercent.Value / 100f;
            bool hungry = OutwardSurvivalPlugin.HungerPenalties.Value && IsHungry(player);
            if (hungry)
                rate *= OutwardSurvivalPlugin.HungryBurnMultiplier.Value;
            rate = Mathf.Clamp01(rate);

            float burn = damage * rate;
            Burned += burn;

            if (OutwardSurvivalPlugin.DebugLogHealth.Value)
                OutwardSurvivalPlugin.Log.LogInfo(
                    $"[Health] took {damage:F1} damage{(hungry ? " (hungry)" : "")}: burned +{burn:F2} (total {Burned:F2}).");
        }

        // Slow max health burn while hungry. Called about once per second.
        public static void HungerTick(Player player)
        {
            float now = Time.time;
            bool first = _lastHungerTick < 0f;
            float dt = now - _lastHungerTick;
            _lastHungerTick = now;

            if (first || dt <= 0f || dt > 3f)
                return;

            if (!OutwardSurvivalPlugin.HungerPenalties.Value || !IsHungry(player))
                return;

            Burned += OutwardSurvivalPlugin.HungerHealthBurnPerSecond.Value * dt;
        }

        // The local player deals less damage while hungry.
        public static void ApplyHungryDamagePenalty(HitData hit)
        {
            Player local = Player.m_localPlayer;
            if (local == null || !OutwardSurvivalPlugin.HungerPenalties.Value || !IsHungry(local))
                return;

            float factor = Mathf.Clamp01(1f - OutwardSurvivalPlugin.HungryDamageReduction.Value / 100f);
            Scale(ref hit.m_damage, factor);
        }

        private static void Scale(ref HitData.DamageTypes d, float f)
        {
            d.m_damage *= f;
            d.m_blunt *= f;
            d.m_slash *= f;
            d.m_pierce *= f;
            d.m_chop *= f;
            d.m_pickaxe *= f;
            d.m_fire *= f;
            d.m_frost *= f;
            d.m_lightning *= f;
            d.m_poison *= f;
            d.m_spirit *= f;
        }
    }

