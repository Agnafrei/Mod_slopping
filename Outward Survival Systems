    // The game calls this about once per second: check Rested, restore burn, apply the burns.
    // __0 is the "hp" out value (max health from food); positional so its name doesn't matter.
    [HarmonyPatch(typeof(Player), "GetTotalFoodValue")]
    internal static class Player_GetTotalFoodValue_Patch
    {
        private static void Postfix(Player __instance, ref float __0, ref float stamina)
        {
            if (__instance != Player.m_localPlayer)
                return;

            StaminaBurn.CheckRested(__instance);
            StaminaBurn.Regenerate(__instance);
            HealthBurn.HungerTick(__instance);

            // Stamina: subtract the burn from max stamina.
            float room = Mathf.Max(0f, stamina - OutwardSurvivalPlugin.MinMaxStamina.Value);
            StaminaBurn.Burned = Mathf.Clamp(StaminaBurn.Burned, 0f, room);
            StaminaBurn.Applied = StaminaBurn.Burned;
            stamina -= StaminaBurn.Applied;

            // Health: subtract the burn from max health, never below the minimum.
            float healthRoom = Mathf.Max(0f, __0 - OutwardSurvivalPlugin.MinMaxHealth.Value);
            HealthBurn.Burned = Mathf.Clamp(HealthBurn.Burned, 0f, healthRoom);

            // The game clamps current health down right after max health drops; that isn't damage.
            if (HealthBurn.Burned > HealthBurn.Applied + 0.01f)
                HealthBurn.IgnoreDecreaseFrame = Time.frameCount;

            HealthBurn.Applied = HealthBurn.Burned;
            __0 -= HealthBurn.Applied;

            if (OutwardSurvivalPlugin.DebugLogStamina.Value)
                OutwardSurvivalPlugin.Log.LogInfo(
                    $"[Stamina] max={stamina:F1}, burned={StaminaBurn.Applied:F2}, " +
                    $"effects=[{StaminaBurn.DescribeEffects(__instance)}]");

            if (OutwardSurvivalPlugin.DebugLogHealth.Value)
                OutwardSurvivalPlugin.Log.LogInfo(
                    $"[Health] max={__0:F1}, burned={HealthBurn.Applied:F2}, " +
                    $"hungry={HealthBurn.IsHungry(__instance)}");
        }
    }

